# --- bağımlılıklar ---
node_modules/
.pnpm-store/

# --- build çıktıları ---
dist/
.astro/
.output/
.vercel/
.netlify/

# --- secret ---
# Yalnızca .env.example commit edilir; gerçek değer taşıyan hiçbir dosya girmez.
.env
.env.*
!.env.example

# --- test çıktıları, log ve trace ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
*.trace
*.zip.tmp

# --- S01 kanıt ve teslim paketleri (repoya girmez) ---
evidence/
*.bundle
duosis-discovery-*.zip
duosis-web-*.zip

# --- kurumsal kaynak belgeleri (repoya girmez) ---
# Sunum/PDF kaynakları iş belgeleridir ve müşteri logoları içerir; sürüm kontrolüne alınmaz.
*.pptx
*.pdf

# --- S03 kurumsal kaynak masterlari (repoya girmez) ---
# Illustrator masterlari ve dogrulanmamis anlatI kaynaklari is belgeleridir.
# Repo su an PRIVATE olsa da her an public'e cevrilebilir; bu yuzden daha KATI
# politika uygulanir: yalnizca sanitize edilmis web turevleri ve hash/provenance
# kayitlari commit edilir. Bkz. docs/source-materials/SOURCE_MATERIALS.md
*.ai
duosis-10-yil-manifesto.html
# Kaynak teslim klasoru (Cyclops_v1.pdf, logo masterlari, manifesto).
/Re_*/

# --- discovery görsel kanıtları (büyük binary) ---
# Ölçüm metinleri (MEASUREMENTS.md) commit edilir; PNG kanıtlar teslim paketiyle dağıtılır.
discovery/baseline/*.png

# --- işletim sistemi / editör ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

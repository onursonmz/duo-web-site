---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import SolutionList from "@components/SolutionList.astro";
import { PUBLIC, getSolutions } from "@lib/content/selectors";
import { solutionsIndexPath } from "@lib/i18n/routes";
import { t } from "@lib/i18n/dictionary";

const locale = "en" as const;
// Üretim sayfası: PUBLIC modu AÇIKÇA kullanılır.
const solutions = await getSolutions(locale, PUBLIC);

const alternates = { tr: solutionsIndexPath("tr"), en: solutionsIndexPath("en") };
// Yayın olgunluk politikası: geliştirme sürümü indekslenmez.
---

<BaseLayout
  locale={locale}
  title={t(locale, "solutions.title")}
  description={t(locale, "solutions.intro")}
  alternates={alternates}
  noindex={true}
  wide={true}
  breadcrumbs={[
    { label: t(locale, "nav.home"), href: "/en/" },
    { label: t(locale, "solutions.title") },
  ]}
>
  <Section tone="light" width="wide" id="solutions">
    <SectionHeading eyebrow="Command Atlas" as="h1" lead={t(locale, "solutions.intro")}>
      {t(locale, "solutions.title")}
    </SectionHeading>
    <SolutionList locale={locale} solutions={solutions} />
  </Section>
</BaseLayout>

---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import SolutionDetail from "@components/SolutionDetail.astro";
import Section from "@components/ui/Section.astro";
import { PUBLIC, getInsights, getSolutionAlternates, getSolutions } from "@lib/content/selectors";
import { solutionPath, solutionsIndexPath } from "@lib/i18n/routes";
import { t } from "@lib/i18n/dictionary";
import { ldOrigin, serviceLd } from "@lib/seo/structuredData";

export const getStaticPaths = (async () => {
  // Üretim sayfası: PUBLIC modu AÇIKÇA kullanılır.
  const solutions = await getSolutions("en", PUBLIC);
  return solutions.map((solution) => ({
    params: { slug: solution.data.slug },
    props: { solution },
  }));
}) satisfies GetStaticPaths;

const { solution } = Astro.props;
const alternates = await getSolutionAlternates(solution.data.translationKey, PUBLIC, solutionPath);

// Bu çözümü referans veren yayınlanmış içgörüler.
const allInsights = await getInsights("en", PUBLIC);
const relatedInsights = allInsights.filter((insight) =>
  insight.data.relatedSolutionRefs.some((ref) => ref.id === solution.id)
);

/*
 * STRUCTURED DATA: yalnızca sayfada GÖRÜNEN ad ve açıklama. Fiyat, müşteri
 * sayısı, değerlendirme veya partnerlik iddiası YOK.
 */
const serviceBlock = serviceLd({
  siteUrl: ldOrigin(Astro.site, Astro.url),
  path: solutionPath("en", solution.data.slug),
  name: solution.data.title,
  description: solution.data.seo.description,
  locale: "en",
});
---

<BaseLayout
  locale="en"
  title={solution.data.title}
  description={solution.data.seo.description}
  alternates={alternates}
  noindex={solution.data.seo.noindex}
  jsonLd={[serviceBlock]}
  wide={true}
  breadcrumbs={[
    { label: t("en", "nav.home"), href: "/en/" },
    { label: t("en", "solutions.title"), href: solutionsIndexPath("en") },
    { label: solution.data.title },
  ]}
>
  <Section tone="light" width="wide">
    <SolutionDetail locale="en" solution={solution} mode={PUBLIC} insights={relatedInsights} />
  </Section>
</BaseLayout>

---
/**
 * İÇGÖRÜLER LANDING (S11 §9).
 *
 * Gövde `InsightsBody` içindedir ve iki dil tarafından paylaşılır: öne çıkan
 * yazı, son yazılar, seri ve etiket dizini, RSS bağlantısı.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import InsightsBody from "@components/insights/InsightsBody.astro";
import { insightsIndexPath } from "@lib/i18n/routes";
import { t } from "@lib/i18n/dictionary";

const locale = "en" as const;
const alternates = { tr: insightsIndexPath("tr"), en: insightsIndexPath("en") };
// Yayın olgunluk politikası: geliştirme sürümü indekslenmez.
---

<BaseLayout
  locale={locale}
  title={t(locale, "insights.title")}
  description={t(locale, "insights.intro")}
  alternates={alternates}
  noindex={true}
  ogImage="/og/og-insights.png"
  wide={true}
  breadcrumbs={[
    { label: t(locale, "nav.home"), href: "/en/" },
    { label: t(locale, "insights.title") },
  ]}
>
  <InsightsBody locale={locale} />
</BaseLayout>

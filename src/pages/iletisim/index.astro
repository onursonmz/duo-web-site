---
/**
 * İLETİŞİM (S12).
 *
 * Doğrulanmış iletişim bilgileri + veri minimizasyonlu form. CTA'ların
 * taşıdığı `?topic=` TEK canonical anahtardır ve merkezî kapalı allowlist'ten
 * geçirilir; bilinmeyen/tekrarlı/aşırı uzun değer `genel`e düşer.
 *
 * Sayfa statik üretildiği için konu, sayfa yüklendikten sonra istemcide de
 * normalize edilir (aynı allowlist ile).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactDetails from "@components/ContactDetails.astro";
import ContactForm from "@components/contact/ContactForm.astro";
import { contactPath, legalPath } from "@lib/i18n/routes";
import { t } from "@lib/i18n/dictionary";
import { GENERAL_TOPIC, topicFromSearchParams } from "@lib/contact/topics";

const locale = "tr" as const;
const alternates = { tr: contactPath("tr"), en: contactPath("en") };

// Derleme zamanında query yoktur; istemci tarafı aynı allowlist ile günceller.
const topic = topicFromSearchParams(Astro.url.searchParams) ?? GENERAL_TOPIC;
---

<BaseLayout
  locale={locale}
  title={t(locale, "contact.title")}
  description={t(locale, "contact.intro")}
  alternates={alternates}
  noindex={true}
  breadcrumbs={[{ label: t(locale, "nav.home"), href: "/" }, { label: t(locale, "contact.title") }]}
>
  <h1>{t(locale, "contact.title")}</h1>
  <p>{t(locale, "contact.intro")}</p>
  <ContactDetails locale={locale} />
  <ContactForm locale={locale} topic={topic} legalHref={legalPath(locale)} />
</BaseLayout>

<script>
  /*
   * KONU EŞLEME — istemci tarafı.
   *
   * Statik sayfa query'yi derleme zamanında göremez. Değer BURADA da aynı
   * merkezî allowlist'ten geçer: bilinmeyen, tekrarlı veya aşırı uzun
   * parametre forma taşınmaz.
   */
  import { topicFromSearchParams } from "@lib/contact/topics";

  const select = document.querySelector<HTMLSelectElement>("#field-topic");
  if (select !== null) {
    const topic = topicFromSearchParams(new URLSearchParams(window.location.search));
    const option = select.querySelector<HTMLOptionElement>(`option[value="${topic}"]`);
    if (option !== null) select.value = topic;
  }
</script>

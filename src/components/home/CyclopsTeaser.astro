---
/**
 * CYCLOPS TEASER.
 *
 * İÇERİK GÜVENLİĞİ: sürüm, lansman durumu, müşteri kullanımı, SLA veya
 * ölçülmüş sonuç iddiası YOKTUR — şema bunlar için alan tanımlamaz.
 * Ziyaretçiye iç yayın süreci veya olgunluk durumu ANLATILMAZ.
 */
import type { CollectionEntry } from "astro:content";
import SectionHeading from "@components/ui/SectionHeading.astro";

interface Props {
  cyclops: CollectionEntry<"homepage">["data"]["cyclops"];
}

const { cyclops }: Props = Astro.props;
---

<div class="cyclops" data-testid="cyclops-teaser">
  <div class="cyclops__head">
    <SectionHeading eyebrow={cyclops.eyebrow} as="h2" lead={cyclops.lead}>
      {cyclops.title}
    </SectionHeading>
  </div>

  <div class="cyclops__side">
    <ul class="cyclops__points">
      {
        cyclops.points.map((point) => (
          <li>
            <span class="cyclops__bullet" aria-hidden="true">
              ▸
            </span>
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* Bölünmüş kompozisyon: başlık solda, kanıt listesi sağda. */
  @media (min-width: 56rem) {
    .cyclops {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .cyclops__points {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cyclops__points li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: var(--space-2xs);
    padding: var(--space-xs) 0;
    border-top: var(--border-width) solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .cyclops__bullet {
    color: var(--signal);
  }
</style>

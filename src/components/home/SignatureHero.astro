---
/**
 * DUOSIS OPERATIONAL UNIVERSE — İMZA SAHNESİ (S15-R2).
 *
 * S15-R1 görsel kabulden geçmedi: "metin solda, şema sağda" düzeni, sabit
 * kamera ve yalnız çizgi hareketi jenerik bir B2B sayfası üretiyordu. Bu
 * sürümde hero bir DİYAGRAM DEĞİL, bir MEKÂNDIR.
 *
 * MİMARİ
 *
 * 1. TEK, SÜREKLİ SAHNE. Yapışkan (`sticky`) bir tuval hero'dan başlayıp
 *    Çözüm Atlası'na kadar AYNI kalır. Scroll ilerlemesi kamerayı çekirdeğe
 *    doğru sürer, çekirdekten GEÇİRİR ve sahneyi kontrollü biçimde açar; aynı
 *    veri yolları düzleşerek atlasın yatay ray geometrisine dönüşür. Bölümler
 *    birbirinin altına düşen dikdörtgenler değildir.
 *
 * 2. SCROLL HİJACK YOK. Tuval scroll konumunu yalnızca OKUR. Sahne kodunda
 *    wheel/touchmove/scroll engelleyen tek bir dinleyici yoktur; yapışkanlık
 *    tamamen CSS'tir.
 *
 * 3. METİN ÖNCE. H1, açıklama ve iki CTA ilk HTML'dedir, animasyonsuzdur ve
 *    tuvalden bağımsız okunur. LCP öğesi H1'dir. Tuval `aria-hidden`.
 *
 * 4. TEK DÜZEN, ÜÇ ÇİZİM KİPİ. Track yüksekliği her kipte AYNIDIR; bu yüzden
 *    sahne açıldığında hiçbir şey yer değiştirmez (CLS = 0):
 *      · `poster`  — WebGL yok / JS yok / context kaybı: statik SVG son durum
 *      · `live`    — WebGL sahnesi, kamera ve akış çalışır
 *      · `static`  — hareket azaltma: WebGL'in TEK karesi, kamera durur
 *
 * 5. GEOMETRİ KODLA ÜRETİLİR. Hazır model, stok asset veya dış kaynak yoktur;
 *    `@lib/scene/universe` içindeki her gövde ikosahedron/torus/tüp/ızgaradan
 *    türetilir. Renkler tasarım sisteminden okunur.
 */
import type { CollectionEntry } from "astro:content";
import Button from "@components/ui/Button.astro";

interface Props {
  hero: CollectionEntry<"homepage">["data"]["hero"];
  stages: CollectionEntry<"homepage">["data"]["heroStages"];
  signals: CollectionEntry<"homepage">["data"]["heroSignals"];
}

const { hero, stages, signals }: Props = Astro.props;

/* ------------------------------------------------------------------ poster
 *
 * WebGL'siz son durum. Sahnenin ÖZETİ değil, ANLAMLI SON KARESİDİR: beş kaynak
 * çekirdeğe bağlanmış, bağlam ağı kurulmuş, karar geçidi açık, aksiyon bağlı.
 * Ölçüler 1600x900 sahne uzayında; `slice` ile ekranı doldurur.
 */
const P_CORE = { x: 1012, y: 430, r: 96 };
const P_SOURCES = [
  { x: 236, y: 168 },
  { x: 512, y: 96 },
  { x: 150, y: 596 },
  { x: 700, y: 760 },
  { x: 1288, y: 118 },
];
const P_GATE = { x: 1274, y: 596 };
const P_ACTION = { x: 1432, y: 726 };

const posterPath = (from: { x: number; y: number }, index: number): string => {
  const dx = P_CORE.x - from.x;
  const dy = P_CORE.y - from.y;
  const bow = index % 2 === 0 ? 118 : -104;
  return `M${from.x} ${from.y} C ${from.x + dx * 0.42} ${from.y + bow}, ${P_CORE.x - dx * 0.3} ${P_CORE.y - bow * 0.5}, ${P_CORE.x - (dx / Math.hypot(dx, dy)) * P_CORE.r} ${P_CORE.y - (dy / Math.hypot(dx, dy)) * P_CORE.r}`;
};

const P_GRID_Y = [120, 250, 380, 510, 640, 770];
const P_GRID_X = [80, 300, 520, 740, 960, 1180, 1400];
---

{
  /*
  `theme-dark` KAPSAYICIDA durur: örtü ve zemin koyu token okumalı.
  (Ölçülen hata: sınıf yalnız hero bölümündeyken `.universe__scrim`
  `:root` açık temasından okuyup sahnenin üstüne AÇIK gri boyuyordu.)
  Atlas bölümü kendi `theme-light` sınıfıyla bağlamı geri alır.
*/
}
<div
  class="universe theme-dark"
  data-universe
  data-universe-state="poster"
  data-testid="hero-universe"
>
  {/* ----------------------------------------------------- yapışkan sahne */}
  <div class="universe__sticky" aria-hidden="true" data-testid="hero-atlas">
    <canvas class="universe__canvas" data-universe-canvas></canvas>

    <div class="universe__poster">
      <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
        <g class="p-grid">
          {P_GRID_Y.map((y) => <line x1="0" y1={y} x2="1600" y2={y} />)}
          {P_GRID_X.map((x) => <line x1={x} y1="0" x2={x} y2="900" />)}
        </g>

        <g class="p-flow">
          {P_SOURCES.map((source, index) => <path d={posterPath(source, index)} />)}
        </g>

        <g class="p-source">
          {
            P_SOURCES.map((source) => (
              <>
                <circle cx={source.x} cy={source.y} r="26" />
                <circle class="p-source__dot" cx={source.x} cy={source.y} r="7" />
              </>
            ))
          }
        </g>

        <g class="p-core">
          <circle cx={P_CORE.x} cy={P_CORE.y} r={P_CORE.r * 1.62}></circle>
          <circle cx={P_CORE.x} cy={P_CORE.y} r={P_CORE.r * 1.28}></circle>
          <circle cx={P_CORE.x} cy={P_CORE.y} r={P_CORE.r}></circle>
          <circle class="p-core__body" cx={P_CORE.x} cy={P_CORE.y} r={P_CORE.r * 0.46}></circle>
        </g>

        <g class="p-decision">
          <path
            d={`M${P_CORE.x + P_CORE.r * 0.7} ${P_CORE.y + P_CORE.r * 0.7} L${P_GATE.x - 46} ${P_GATE.y - 30}`}
          ></path>
          <path d={`M${P_GATE.x} ${P_GATE.y - 54} A 54 54 0 0 1 ${P_GATE.x} ${P_GATE.y + 54}`}
          ></path>
          <path d={`M${P_GATE.x} ${P_GATE.y + 54} A 54 54 0 0 1 ${P_GATE.x} ${P_GATE.y - 54}`}
          ></path>
          <path d={`M${P_GATE.x + 54} ${P_GATE.y + 18} L${P_ACTION.x - 52} ${P_ACTION.y - 40}`}
          ></path>
        </g>

        <g class="p-action">
          <path
            d={`M${P_ACTION.x - 52} ${P_ACTION.y} L${P_ACTION.x - 26} ${P_ACTION.y - 45} L${P_ACTION.x + 26} ${P_ACTION.y - 45} L${P_ACTION.x + 52} ${P_ACTION.y} L${P_ACTION.x + 26} ${P_ACTION.y + 45} L${P_ACTION.x - 26} ${P_ACTION.y + 45} Z`}
          ></path>
        </g>
      </svg>
    </div>

    <div class="universe__scrim"></div>
  </div>

  {/* ----------------------------------------------------- akıştaki içerik */}
  <div class="universe__flow">
    <section class="universe__hero theme-dark" id="hero" data-universe-tokens>
      <div class="hero__copy">
        <p class="hero__eyebrow">{hero.eyebrow}</p>
        <h1 class="hero__title">{hero.title}</h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__actions">
          <Button variant="primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
          <Button variant="secondary" href={hero.secondaryCta.href}
            >{hero.secondaryCta.label}</Button
          >
        </div>
        {
          /*
          SİNYAL TÜRLERİ — sahneye SERPİŞTİRİLMİŞ mono etiketler değil, tek
          satırlık derli toplu bir künye. Taşıdıkları bilgi aşama metinlerinde
          zaten yazılıdır; bu yüzden dekoratiftir.
        */
        }
        <ul class="hero__signals" aria-hidden="true">
          {signals.map((signal) => <li>{signal}</li>)}
        </ul>
      </div>
    </section>

    {
      /*
      BEŞ AŞAMA — sahnedeki yolculuğun ANLATISI.
      Kamera kaynaklardan çekirdeğe, oradan karara ve aksiyona ilerlerken bu
      duraklar sırayla açılır. Hepsi DOM'da ve hareket azaltmada tamamen
      görünürdür; hiçbiri yalnız opaklıkla gelmez (maske açılışı).
    */
    }
    <ol class="universe__journey" data-testid="hero-stages">
      {
        stages.map((stage, index) => (
          <li class="journey__step theme-dark" data-stage={stage.key}>
            <div class="journey__inner">
              <span class="journey__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h2 class="journey__title">{stage.title}</h2>
              <p class="journey__body">{stage.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    {
      /*
      DEVİR BANDI — kameranın çekirdekten geçip sahneyi AÇTIĞI aralık. İçerik
      taşımaz; yolculuğun bittiği yeri işaretler (`p = 1`).
    */
    }
    <div class="universe__handoff" data-universe-end aria-hidden="true"></div>

    <div class="universe__atlas"><slot /></div>
  </div>
</div>

<script>
  /**
   * SAHNE YÜKLEYİCİ.
   *
   * Üç şeyi yapar ve başka hiçbir şeye karışmaz:
   *   1. WebGL gerçekten var mı diye BAKAR (yoksa 0 bayt indirilir),
   *   2. modülü İLK BOYAMADAN SONRA dinamik olarak getirir (LCP'yi bloklamaz),
   *   3. sahne ilk kareyi çizdiğinde tuvali açar.
   *
   * Başarısızlığın her biçimi (WebGL yok, modül gelmedi, context kaybı) aynı
   * yere düşer: statik poster.
   */
  import type { UniverseHandle } from "../../lib/scene/universe";

  const root = document.querySelector<HTMLElement>("[data-universe]");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-universe-canvas]");
  const journeyEnd = root?.querySelector<HTMLElement>("[data-universe-end]");
  const tokenSource = root?.querySelector<HTMLElement>("[data-universe-tokens]");

  /*
   * GPU YOKSA SAHNE DE YOK.
   *
   * `failIfMajorPerformanceCaveat` tarayıcıya "yalnızca gerçek donanım
   * hızlandırma varsa context ver" der. Yazılım rasterleştirici (SwiftShader,
   * llvmpipe) üzerinde tam ekran bir sahne saniyede birkaç kare çizer,
   * işlemciyi doldurur ve pili yakar; doğru davranış statik postere düşmektir.
   *
   * ÖLÇÜLDÜ: bu kapı olmadan başsız tarayıcıda ana sayfayı açan İLGİSİZ
   * testler bile 30 saniyelik zaman aşımına düşüyordu — sayfa yazılım
   * rasterleştirici yüzünden yanıt veremiyordu.
   *
   * `?universe=force` kapıyı AÇIKÇA devre dışı bırakır. Tek kullanım yeri
   * kanıt üretimi ve WebGL yolunu doğrulayan testlerdir; normal ziyaretçi
   * bu parametreyi hiç görmez.
   */
  const forced = /(?:^|[?&])universe=force(?:&|$)/.test(location.search);

  /** Bilinen yazılım rasterleştiriciler. */
  const SOFTWARE = /swiftshader|llvmpipe|softwarerasterizer|basic render|microsoft basic/i;

  function webglAvailable(): boolean {
    try {
      const probe = document.createElement("canvas");
      const attributes = { failIfMajorPerformanceCaveat: !forced };
      const context = (probe.getContext("webgl2", attributes) ??
        probe.getContext("webgl", attributes)) as WebGLRenderingContext | null;
      if (context === null) return false;

      /*
       * `failIfMajorPerformanceCaveat` TEK BAŞINA yetmiyor: ölçüldü, başsız
       * Chromium SwiftShader ile bayrağa rağmen context veriyor. Bu yüzden
       * sürücü adı ayrıca okunur. Ad okunamıyorsa (gizlilik kısıtı) sahne
       * AÇILIR — yalnızca BİLİNEN yazılım rasterleştiriciler elenir.
       */
      const info = context.getExtension("WEBGL_debug_renderer_info");
      const renderer =
        info === null ? "" : String(context.getParameter(info.UNMASKED_RENDERER_WEBGL));

      // Yoklama context'i sayıyı doldurmasın: hemen bırakılır.
      context.getExtension("WEBGL_lose_context")?.loseContext();

      return forced || !SOFTWARE.test(renderer);
    } catch {
      return false;
    }
  }

  if (
    root !== null &&
    canvas !== null &&
    canvas !== undefined &&
    journeyEnd !== null &&
    journeyEnd !== undefined &&
    tokenSource !== null &&
    tokenSource !== undefined
  ) {
    const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let handle: UniverseHandle | undefined;

    const boot = (): void => {
      if (saveData === true || !webglAvailable()) return;
      void import("../../lib/scene/universe")
        .then((module) => {
          handle = module.createUniverse({
            canvas,
            track: root,
            journeyEnd,
            tokenSource,
            reducedMotion,
            allowSoftware: forced,
            onReady: () =>
              root.setAttribute("data-universe-state", reducedMotion ? "static" : "live"),
            onFail: () => {
              root.setAttribute("data-universe-state", "poster");
              root.style.setProperty("--u-theme", "0");
              handle?.dispose();
              handle = undefined;
            },
            onTheme: (value) => root.style.setProperty("--u-theme", value.toFixed(3)),
          });
        })
        .catch(() => root.setAttribute("data-universe-state", "poster"));
    };

    /*
     * İLK BOYAMADAN SONRA: H1 ekrana geldikten sonra indirme başlar.
     *
     * `requestIdleCallback` ile geciktirmek DENENDİ ve ÖLÇÜLDÜ: LCP ve CLS
     * değişmedi (2,71 sn / 0,000), bloklama süresi ise iyileşmedi. Geciktirmek
     * yalnızca sahnenin açılış sekansını geç başlatıyordu. Bu yüzden sahne ilk
     * kareden hemen sonra açılır.
     */
    requestAnimationFrame(() => requestAnimationFrame(boot));
  }
</script>

<style>
  /* ------------------------------------------------------------- kapsayıcı */

  .universe {
    position: relative;
    /* Sahne temasının DOM karşılığı: 0 koyu, 1 açık. Sahne her karede yazar. */
    --u-theme: 0;
    --u-fold: 100svh;
    --u-step: 46svh;
    --u-handoff: 170svh;
    background: var(--surface-sunken);
  }

  /*
   * YAPIŞKAN SAHNE.
   *
   * `sticky` + akışın NEGATİF üst boşluğu: içerik tuvalin ÜSTÜNDE akar, tuval
   * yerinde durur. Scroll tarayıcının; JavaScript yalnızca konumu okur.
   */
  .universe__sticky {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: clip;
  }

  .universe__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 700ms var(--motion-ease);
  }

  [data-universe-state="live"] .universe__canvas,
  [data-universe-state="static"] .universe__canvas {
    opacity: 1;
  }

  .universe__poster {
    position: absolute;
    inset: 0;
    transition: opacity 500ms var(--motion-ease);
  }

  .universe__poster svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  [data-universe-state="live"] .universe__poster,
  [data-universe-state="static"] .universe__poster {
    opacity: 0;
  }

  /*
   * OKUNURLUK ÖRTÜSÜ.
   *
   * Metnin ARKASINI karartır, sahnenin sağını AÇIK bırakır. Kart veya kenarlık
   * kullanılmaz: kontrast kontrollü bir ışık düşüşüyle kurulur. Sahne aydınlığa
   * döndüğünde (`--u-theme` -> 1) örtü tamamen kalkar.
   */
  .universe__scrim {
    position: absolute;
    inset: 0;
    opacity: calc(1 - var(--u-theme));
    background:
      linear-gradient(
        102deg,
        color-mix(in srgb, var(--surface-sunken) 86%, transparent) 0%,
        color-mix(in srgb, var(--surface-sunken) 62%, transparent) 32%,
        transparent 66%
      ),
      radial-gradient(
        128% 84% at 64% 44%,
        transparent 36%,
        color-mix(in srgb, var(--surface-sunken) 62%, transparent) 100%
      );
  }

  /* ------------------------------------------------------------------ akış */

  .universe__flow {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }

  /* ---------------------------------------------------------------- hero */

  .universe__hero {
    display: grid;
    align-content: center;
    min-height: var(--u-fold);
    padding-block: max(9svh, 5rem) 10svh;
    padding-inline: var(--container-gutter);
    background: transparent;
  }

  .hero__copy {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-md);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    max-width: 17ch;
    color: var(--text-primary);
    font-size: clamp(2.25rem, 1.05rem + 2.9vw, 3.5rem);
    font-weight: var(--weight-semibold);
    line-height: 1.04;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .hero__lead {
    margin: var(--space-lg) 0 0;
    max-width: 42ch;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .hero__signals li {
    position: relative;
    padding-left: var(--space-sm);
  }

  .hero__signals li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 5px;
    height: 5px;
    background: var(--signal);
  }

  /* ------------------------------------------------------------- yolculuk */

  .universe__journey {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey__step {
    display: grid;
    align-content: center;
    min-height: var(--u-step);
    padding-inline: var(--container-gutter);
    background: transparent;
  }

  .journey__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /*
   * YOLCULUK METNİ SAHNEYLE BİRLİKTE DÖNER.
   *
   * Kamera çekirdekten geçtikten sonra zemin koyudan açığa geçiyor; sabit
   * açık renkli metin o anda ÖLÇÜLEBİLİR biçimde okunamaz hâle geliyordu
   * (beyaz üstüne beyaz). Renk `--u-theme` ile aynı eğri üzerinde ters yöne
   * döner: koyu zeminde açık, açık zeminde koyu. İlk değer (0) sunucudan
   * gelir; sahne çalışmasa da metin doğru renktedir.
   */
  .journey__index {
    display: block;
    color: var(--signal);
    color: color-mix(in srgb, var(--signal-surface) calc(var(--u-theme) * 100%), var(--signal));
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
  }

  .journey__title {
    margin: var(--space-2xs) 0 0;
    max-width: 18ch;
    color: var(--text-primary);
    color: color-mix(in srgb, var(--text-inverse) calc(var(--u-theme) * 100%), var(--text-primary));
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .journey__body {
    margin: var(--space-sm) 0 0;
    max-width: 34ch;
    color: var(--text-secondary);
    color: color-mix(
      in srgb,
      var(--text-inverse) calc(var(--u-theme) * 100%),
      var(--text-secondary)
    );
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }

  /*
   * MASKE AÇILIŞI — opaklık DEĞİL.
   *
   * `animation-timeline` `--scroll-timeline` üzerinden okunur: doğrudan
   * yazıldığında CSS küçültücü onu `animation` kısayoluna birleştiriyor ve
   * kural tamamen düşüyordu (S15-R1'de ölçüldü, bkz. tokens.css).
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .journey__inner {
        animation: journey-open linear both;
        animation-timeline: var(--scroll-timeline);
        animation-range: entry 8% entry 46%;
      }
    }
  }

  @keyframes journey-open {
    from {
      clip-path: inset(-2rem -2rem 100% -2rem);
      transform: translateY(1.25rem);
    }

    to {
      clip-path: inset(-2rem -2rem -2rem -2rem);
      transform: translateY(0);
    }
  }

  /*
   * DEVİR BANDI.
   *
   * İçeriği yoktur ama BOŞ değildir: kameranın çekirdekten geçtiği, sahnenin
   * aydınlığa döndüğü ve yolların düzleştiği aralık burada yaşar. Son yolculuk
   * adımı bu bant başlamadan ekrandan çıkar; böylece gri geçiş anında ekranda
   * okunması gereken metin KALMAZ.
   */
  .universe__handoff {
    height: var(--u-handoff);
  }

  /* --------------------------------------------------------------- atlas */

  /*
   * DEVİR.
   *

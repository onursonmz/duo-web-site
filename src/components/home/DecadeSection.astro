---
/**
 * 10. YIL ÖNİZLEMESİ.
 *
 * Tema olarak kullanılır fakat DOĞRULANMAMIŞ müşteri rakamları ve tarihsel
 * kilometre taşları GÖSTERİLMEZ. Yalnızca doğrulanmış milestone kayıtları
 * (verificationStatus: verified) listelenir; hiçbiri yoksa liste hiç
 * render edilmez ve bölüm anlatıyla dengelenir.
 */
import type { CollectionEntry } from "astro:content";
import SectionHeading from "@components/ui/SectionHeading.astro";

interface Props {
  decade: CollectionEntry<"homepage">["data"]["decade"];
  milestones: CollectionEntry<"milestones">[];
}

const { decade, milestones }: Props = Astro.props;
---

<div class="decade" data-testid="decade-section">
  <SectionHeading eyebrow={decade.eyebrow} as="h2" lead={decade.lead}>
    {decade.title}
  </SectionHeading>

  {
    milestones.length > 0 && (
      <ol class="decade__rail" data-testid="decade-milestones">
        {milestones.map((milestone) => (
          <li class="decade__item">
            <span class="decade__year">{milestone.data.year}</span>
            <h3 class="decade__title">{milestone.data.title}</h3>
            <p class="decade__summary">{milestone.data.summary}</p>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  .decade__rail {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .decade__rail {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .decade__item {
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--border-strong);
  }

  .decade__year {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--signal);
  }

  .decade__title {
    margin: var(--space-3xs) 0 var(--space-2xs);
    font-size: var(--text-lg);
  }

  .decade__summary {
    margin: 0;
    max-width: 42ch;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>

---
/**
 * 10. YIL ÖNİZLEMESİ.
 *
 * Tema olarak kullanılır fakat DOĞRULANMAMIŞ müşteri rakamları ve tarihsel
 * kilometre taşları GÖSTERİLMEZ. Yalnızca doğrulanmış milestone kayıtları
 * (verificationStatus: verified) listelenir; hiçbiri yoksa liste hiç
 * render edilmez ve bölüm anlatıyla dengelenir.
 */
import type { CollectionEntry } from "astro:content";
import SectionHeading from "@components/ui/SectionHeading.astro";
import { t } from "@lib/i18n/dictionary";
import { journeyPath } from "@lib/i18n/routes";
import type { Locale } from "@lib/content/schema";

interface Props {
  locale: Locale;
  decade: CollectionEntry<"homepage">["data"]["decade"];
  milestones: CollectionEntry<"milestones">[];
}

const { locale, decade, milestones }: Props = Astro.props;
---

<div class="decade" data-testid="decade-section">
  <div class="decade__intro">
    <SectionHeading eyebrow={decade.eyebrow} as="h2">
      {decade.title}
    </SectionHeading>
    <div class="decade__aside">
      <p class="decade__lead">{decade.lead}</p>
      {/* Önizleme; tam kayıt Hakkımızda sayfasındaki zaman çizelgesindedir. */}
      <a class="decade__link" href={journeyPath(locale)} data-testid="decade-journey-link">
        {t(locale, "about.journeyLink")}
      </a>
    </div>
  </div>

  {
    milestones.length > 0 && (
      <ol class="decade__rail" data-testid="decade-milestones">
        {milestones.map((milestone, index) => (
          <li class="decade__item" style={`--decade-step:${index}`}>
            {/*
              Ray üzerindeki düğüm: yıllar düz metin değil, zaman çizgisinin
              üstündeki duraklar. Son durak BAKIR — bugün durduğumuz yer.
            */}
            <span class="decade__node" aria-hidden="true" />
            <span class="decade__year">{milestone.data.year}</span>
            <h3 class="decade__title">{milestone.data.title}</h3>
            <p class="decade__summary">{milestone.data.summary}</p>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  /*
   * Anlatı iki sütuna kurulur: başlık solda, açıklama sağda. Doğrulanmış
   * kilometre taşı yoksa bölüm tek sütunluk bir metin bloğuna düşüp sağ yarıyı
   * boş bırakıyordu; uydurma kayıt eklemeden düzenle dengelenir.
   */
  .decade__intro {
    display: grid;
    gap: var(--space-sm) var(--space-2xl);
  }

  @media (min-width: 60rem) {
    .decade__intro {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  .decade__intro :global(.heading) {
    margin-bottom: 0;
  }

  .decade__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .decade__lead {
    margin: 0;
    max-width: 46ch;
    color: var(--text-secondary);
    font-size: var(--text-md);
  }

  .decade__rail {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .decade__rail {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  /*
   * ZAMAN RAYI.
   *
   * Yıllar artık ayrı ayrı metin blokları değil; sürekli bir çizginin
   * üstündeki duraklar. Çizgi `::before` ile üretilir, ek DOM düğümü yok.
   */
  .decade__rail {
    position: relative;
  }

  @media (min-width: 52rem) {
    .decade__rail::before {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-start: 0;
      height: var(--border-width);
      background: var(--border-subtle);
    }
  }

  .decade__item {
    position: relative;
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--border-strong);
  }

  .decade__node {
    position: absolute;
    inset-block-start: calc(var(--border-width) * -1 - 3px);
    inset-inline-start: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }

  /*
   * SON DURAK BAKIR: bugün durduğumuz nokta. Bakır yalnızca karar ve
   * dönüm anlarında kullanılır — 10. yıl bunlardan biridir.
   */
  .decade__item:last-child .decade__node {
    background: var(--decision);
    width: 9px;
    height: 9px;
    inset-block-start: calc(var(--border-width) * -1 - 4px);
  }

  .decade__item:last-child {
    border-top-color: var(--decision);
  }

  /*
   * KONTROLLÜ GİRİŞ.
   *
   * Duraklar sırayla AÇILIR; kaydırmayı ele geçirmez, yalnızca görünür
   * olduğunda bir kez oynar. `animation-timeline` desteklenmiyorsa hiçbir şey
   * olmaz ve duraklar zaten görünürdür.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .decade__item {
        animation: decade-step linear both;
        animation-timeline: var(--scroll-timeline);
        animation-range: entry 10% entry 55%;
      }
    }
  }

  /*
   * MASKE İLE AÇILIR, OPAKLIKLA DEĞİL.
   *
   * ÖLÇÜLMÜŞ SORUN: açılış `opacity: 0.35` ile başlıyordu. Scroll tabanlı
   * animasyon gerçekten bağlandıktan sonra (bkz. `--scroll-timeline`) henüz
   * görünmemiş duraklar %35 opaklıkta kalıyor ve axe bunları GERÇEK bir
   * kontrast ihlali olarak raporluyordu (#606468 / #14181c = 2.99:1).
   *
   * Maske açılışı hem bu ihlali kaldırır hem de talimattaki "bölümler yalnız
   * opacity ile görünmemeli" kuralını karşılar. Negatif `inset` değerleri ray
   * düğümünün (`.decade__node`) kutunun dışına taşan kısmını kırpmamak
   * içindir.
   */
  @keyframes decade-step {
    from {
      clip-path: inset(-8px -8px 100% -8px);
      transform: translateY(10px);
    }
    to {
      clip-path: inset(-8px -8px -8px -8px);
      transform: translateY(0);
    }
  }

  .decade__year {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--signal);
  }

  .decade__title {
    margin: var(--space-3xs) 0 var(--space-2xs);
    font-size: var(--text-lg);
  }

  .decade__summary {
    margin: 0;
    max-width: 42ch;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>

---
/**
 * HERO — STATİK FALLBACK.
 *
 * Hareket YOK (Command Atlas hero motion S06 kapsamıdır). İlk ekranda üç
 * soruyu yanıtlar: ne yapıyoruz, farkımız ne, sıradaki adım ne.
 */
import type { CollectionEntry } from "astro:content";
import Button from "@components/ui/Button.astro";

interface Props {
  hero: CollectionEntry<"homepage">["data"]["hero"];
}

const { hero }: Props = Astro.props;
---

<div class="hero" id="top">
  <p class="hero__eyebrow">{hero.eyebrow}</p>
  <h1 class="hero__title">{hero.title}</h1>
  <div class="hero__body">
    <p class="hero__lead">{hero.lead}</p>
    <div class="hero__actions">
      <Button variant="primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
      <Button variant="secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</Button>
    </div>
  </div>
</div>

<style>
  .hero__eyebrow {
    margin: 0 0 var(--space-sm);
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hero__title {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
  }

  /* Kontrollü asimetri: metin sütunu sağa kayar, başlık tam genişlikte kalır. */
  .hero__body {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--border-subtle);
  }

  @media (min-width: 56rem) {
    .hero__body {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .hero__lead {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (min-width: 56rem) {
    .hero__actions {
      margin-top: 0;
      justify-content: flex-end;
    }
  }
</style>

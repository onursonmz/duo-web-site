---
import type { CollectionEntry } from "astro:content";
import { t } from "@lib/i18n/dictionary";
import { solutionPath } from "@lib/i18n/routes";
import type { Locale } from "@lib/content/schema";

interface Props {
  locale: Locale;
  solutions: CollectionEntry<"solutions">[];
}

const { locale, solutions } = Astro.props;
---

{
  solutions.length > 0 ? (
    <ul class="solution-list" data-testid="solution-list">
      {solutions.map((solution) => (
        <li data-solution-key={solution.data.translationKey}>
          <a href={solutionPath(locale, solution.data.slug)}>{solution.data.title}</a>
          <p>{solution.data.summary}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p data-testid="solutions-empty">{t(locale, "solutions.empty")}</p>
  )
}

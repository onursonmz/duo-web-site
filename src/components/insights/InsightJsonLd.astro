---
/**
 * BlogPosting YAPILANDIRILMIŞ VERİ (S11 §14, S13'te tekilleştirildi).
 *
 * TEMEL KURAL: burada üretilen her alanın sayfada GÖRÜNEN bir karşılığı
 * vardır. Yapılandırılmış veri, sayfanın söylemediği bir şeyi arama motoruna
 * söylemek için kullanılmaz.
 *
 *   headline      = sayfadaki <h1> ile AYNI metin (sayfa başlığı + site adı
 *                   birleşimi DEĞİL)
 *   author        = meta rayında görünen yazar (ortak imza → Organization)
 *   datePublished = meta rayındaki <time> ile aynı gün
 *   dateModified  = yalnızca sayfada güncelleme tarihi gösteriliyorsa
 *   mainEntityOfPage = canonical URL
 *
 * TAŞIMADIKLARI: müşteri adı, kurum iddiası, derecelendirme, etkileşim
 * sayacı veya sayfada gösterilmeyen herhangi bir metrik.
 *
 * S13 NOTU: nesne artık burada elle kurulmuyor; TEK üretici
 * `blogPostingLd` kullanılıyor. İki ayrı BlogPosting üreticisi olsaydı biri
 * diğerinden sessizce ayrışabilirdi (ve bir süre ikisi birden basılmıştı).
 * `tests/unit/structured-data.test.ts` bu tek üreticiyi doğruluyor.
 */
import type { Locale } from "@lib/content/schema";
import type { InsightView } from "@lib/content/insightView";
import { blogPostingLd } from "@lib/seo/structuredData";

interface Props {
  locale: Locale;
  view: InsightView;
  /** Sayfadaki <h1> metni. */
  headline: string;
  description: string;
  authorName: string;
  canonical: string;
}

const { locale, view, headline, description, authorName, canonical }: Props = Astro.props;

/*
 * `url` ve `@id` canonical'dan TÜRETİLİR; ayrı yoldan kurulup "aynı olmasını
 * ummak" yerine yapı gereği aynıdır.
 */
const canonicalUrl = new URL(canonical);

const jsonLd = blogPostingLd({
  siteUrl: canonicalUrl.origin,
  path: canonicalUrl.pathname,
  headline,
  description,
  locale,
  datePublished: view.publishedIso,
  ...(view.updatedIso === undefined ? {} : { dateModified: view.updatedIso }),
  authorName,
  articleSection: view.seriesLabel,
  ...(view.tags.length === 0 ? {} : { keywords: view.tags }),
});
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
  data-testid="blogposting-jsonld"
/>

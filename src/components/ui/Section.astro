---
/**
 * TEMA BAĞLAMI.
 *
 * Açık/koyu yüzey ayrımı bileşenlerin İÇİNDE çözülmez. Section bir tema sınıfı
 * uygular, içindeki tüm bileşenler aynı semantic token adlarını okur. Böylece
 * bir bileşen hangi yüzeyde olduğunu bilmek zorunda kalmaz ve koyu bölümde
 * kontrast bozulmaz.
 */
interface Props {
  tone?: "light" | "dark";
  /**
   * Dar okuma sütunu mu, geniş editorial ızgara mı, yoksa TAM GENİŞLİK mi.
   *
   * `bleed`, kenardan kenara uzanan imza sahneleri içindir (hero, bölüm
   * geçişleri). İç boşluğu bileşenin KENDİSİ kurar; aksi halde sahne 76rem
   * kapsayıcısına hapsolur ve ekranı dolduran kompozisyon kurulamaz.
   */
  width?: "text" | "wide" | "bleed";
  /**
   * Dikey ritim. `tight`, ilk ekran bütçesi olan bölümler içindir: içerik
   * yukarı çekilir, bölüm ritmi bozulmaz. `none`, dikey boşluğu tamamen
   * bileşene devreder (hero ve geçiş bantları).
   */
  padding?: "default" | "tight" | "none";
  as?: "section" | "div" | "article" | "footer" | "header";
  class?: string;
  id?: string;
}

// Acik tip ek aciklamasi: dinamik <Tag> render eden bilesenlerde Astro'nun
// ortuk Props baglantisi olusmuyor ve `noUnusedLocals` tetikleniyor.
const {
  tone = "light",
  width = "wide",
  padding = "default",
  as: Tag = "section",
  class: className,
  id,
}: Props = Astro.props;
---

<Tag class:list={[`theme-${tone}`, "section", `section--${padding}`, className]} id={id}>
  <div class:list={["section__inner", `section__inner--${width}`]}>
    <slot />
  </div>
</Tag>

<style>
  .section {
    padding-block: var(--space-2xl);
  }

  .section--tight {
    padding-block: var(--space-xl);
  }

  /* Dikey ritmi bileşene devreder; ekranı dolduran sahneler bunu kullanır. */
  .section--none {
    padding-block: 0;
  }

  .section__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }

  .section__inner--wide {
    max-width: var(--container-max);
  }

  .section__inner--text {
    max-width: var(--container-text);
  }

  /* Kenardan kenara: kapsayıcı sınırı ve gutter bileşene devredilir. */
  .section__inner--bleed {
    max-width: none;
    padding-inline: 0;
  }

  @media (max-width: 40rem) {
    .section {
      padding-block: var(--space-xl);
    }

    .section--tight {
      padding-block: var(--space-lg);
    }

    .section--none {
      padding-block: 0;
    }
  }
</style>

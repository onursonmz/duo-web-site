---
/**
 * EYEBROW + SECTION HEADING.
 *
 * Eyebrow monospace sistem etiketidir (sınırlı kullanım). Başlık seviyesi
 * çağıran tarafından verilir; bileşen kendi başına h2 varsaymaz, böylece
 * belge başlık hiyerarşisi bozulmaz.
 */
interface Props {
  eyebrow?: string;
  /** Sayfanin ana basligi ise h1; aksi halde bolum seviyesine gore secilir. */
  as?: "h1" | "h2" | "h3" | "h4";
  lead?: string;
  align?: "start" | "center";
  id?: string;
}

// Acik tip ek aciklamasi: bkz. Section.astro.
const { eyebrow, as: Tag = "h2", lead, align = "start", id }: Props = Astro.props;
---

<header class:list={["heading", `heading--${align}`, Tag === "h1" && "heading--page"]}>
  {eyebrow && <p class="heading__eyebrow">{eyebrow}</p>}
  <Tag class="heading__title" id={id}><slot /></Tag>
  {lead && <p class="heading__lead">{lead}</p>}
</header>

<style>
  .heading {
    margin-bottom: var(--space-lg);
    max-width: 46rem;
  }

  /*
   * SAYFA GİRİŞİ (`as="h1"`).
   *
   * Alt sayfalar boş beyaz bir sayfanın tepesinde başlıyordu. Bu blok aynı
   * evrene ait bir giriş kurar ama ana hero'yu TAKLİT ETMEZ: ekstra JavaScript,
   * animasyon veya asset yoktur; yalnızca ortak bileşenin CSS'i.
   *
   * Katmanlar: üstte ince hat, solda cyan ray, arkada ÇOK düşük opaklıklı
   * teknik ızgara, eyebrow ucunda tek bir action vurgusu.
   */
  .heading--page {
    --heading-grid: color-mix(in srgb, var(--border-subtle) 38%, transparent);

    position: relative;
    margin-bottom: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-lg);
    padding-inline-start: var(--space-lg);
    max-width: 54rem;
    border-top: var(--border-width) solid var(--border-subtle);
    background-image:
      repeating-linear-gradient(to right, var(--heading-grid) 0 1px, transparent 1px 4.5rem),
      repeating-linear-gradient(to bottom, var(--heading-grid) 0 1px, transparent 1px 4.5rem);
    background-position: left top;
  }

  /* Sol ray: sinyal rengi, aşağı doğru söner. */
  .heading--page::before {
    content: "";
    position: absolute;
    inset-block: 0 var(--space-md);
    inset-inline-start: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--signal),
      color-mix(in srgb, var(--signal) 0%, transparent)
    );
  }

  .heading--page.heading--center {
    padding-inline-start: 0;
    background-image: none;
  }

  .heading--page.heading--center::before {
    content: none;
  }

  .heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .heading__eyebrow {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .heading--page .heading__eyebrow {
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  /* Tek action vurgusu — sayfada bir noktada, küçük ve keskin. */
  .heading--page .heading__eyebrow::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: var(--space-2xs);
    vertical-align: middle;
    background: var(--action);
  }

  /* İnce sinyal çizgisi: eyebrow'u başlıktan ayırır, dekoratiftir. */
  .heading__eyebrow::before {
    content: "";
    display: inline-block;
    width: var(--space-md);
    height: 1px;
    margin-right: var(--space-2xs);
    vertical-align: middle;
    background: var(--signal);
  }

  .heading--center .heading__eyebrow::before {
    display: none;
  }

  .heading__title {
    margin: 0;
  }

  /* Sayfa girişinde başlık BÜYÜK ve sıkı; negatif alan başlığın işi. */
  .heading--page .heading__title {
    max-width: 20ch;
    font-size: clamp(2rem, 1.15rem + 2.2vw, 3rem);
    font-weight: var(--weight-semibold);
    line-height: 1.06;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }

  .heading--page .heading__lead {
    margin-top: var(--space-md);
    max-width: 44ch;
  }

  .heading__lead {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: var(--container-text);
  }

  .heading--center .heading__lead {
    margin-inline: auto;
  }
</style>

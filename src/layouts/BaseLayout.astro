---
import { buildPageTitle } from "@lib/seo/pageTitle";
import { t } from "@lib/i18n/dictionary";
import { homePath, solutionsIndexPath } from "@lib/i18n/routes";
import type { Locale } from "@lib/content/schema";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import "../styles/base.css";

interface Props {
  locale: Locale;
  title?: string;
  description: string;
  /** Dil değiştiricinin karşılık arayacağı kayıt anahtarı. */
  translationKey?: string;
  /** Aynı kaydın diğer dillerdeki yolları. Yoksa "çeviri mevcut değil" davranışı. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** Dar okuma sutunu yerine tam genislik (tasarim sistemi onizlemesi gibi). */
  wide?: boolean;
}

const { locale, title, description, alternates = {}, noindex = false, wide = false } = Astro.props;

const SITE_NAME = t(locale, "site.name");
const pageTitle = buildPageTitle({ pageTitle: title, siteName: SITE_NAME });
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      Object.entries(alternates).map(([altLocale, href]) => (
        <link rel="alternate" hreflang={altLocale} href={new URL(href, canonical).href} />
      ))
    }
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "nav.skipToContent")}</a>

    <header class="site-header">
      <p class="site-header__brand">{SITE_NAME}</p>

      <nav class="site-nav" aria-label={t(locale, "nav.home")}>
        <a href={homePath(locale)}>{t(locale, "nav.home")}</a>
        <a href={solutionsIndexPath(locale)}>{t(locale, "nav.solutions")}</a>
      </nav>

      <LanguageSwitcher locale={locale} alternates={alternates} />
    </header>

    <main id="main-content" class:list={[wide && "main--wide"]} tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p>{t(locale, "site.tagline")}</p>
    </footer>
  </body>
</html>

<style>
  /* Tam genislik onizleme: okuma sutunu siniri kaldirilir, iç boşluk
     bolumlere devredilir. */
  .main--wide {
    max-width: none;
    padding: 0;
  }
</style>

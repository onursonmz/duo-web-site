---
import { buildPageTitle } from "@lib/seo/pageTitle";
import { t } from "@lib/i18n/dictionary";
import type { Locale } from "@lib/content/schema";
import SiteHeader from "@components/shell/SiteHeader.astro";
import SiteFooter from "@components/shell/SiteFooter.astro";
import Breadcrumb, { type Crumb } from "@components/shell/Breadcrumb.astro";
import "../styles/base.css";

interface Props {
  locale: Locale;
  title?: string;
  description: string;
  /** Dil değiştiricinin karşılık arayacağı kayıt anahtarı. */
  translationKey?: string;
  /** Aynı kaydın diğer dillerdeki yolları. Yoksa "çeviri mevcut değil" davranışı. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** Dar okuma sütunu yerine tam genişlik (ana sayfa, tasarım sistemi vb.). */
  wide?: boolean;
  /** Breadcrumb izi; iki veya daha fazla öğe varsa render edilir. */
  breadcrumbs?: Crumb[];
  /** Sosyal önizleme görseli (mutlak veya kök-göreli yol). */
  ogImage?: string;
  /** Sayfa türü — Open Graph. */
  ogType?: "website" | "article";
}

const {
  locale,
  title,
  description,
  alternates = {},
  noindex = false,
  wide = false,
  breadcrumbs = [],
  ogImage,
  ogType = "website",
}: Props = Astro.props;

const SITE_NAME = t(locale, "site.name");
const pageTitle = buildPageTitle({ pageTitle: title, siteName: SITE_NAME });
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = ogImage === undefined ? undefined : new URL(ogImage, canonical).href;
---

<!doctype html>
<!--
  `no-js`: JS'e bağlı kontrollerin (mega menü açıcı, mobil hamburger) hiç
  görünmemesini sağlar. Aşağıdaki satır içi script sınıfı ilk boyamadan ÖNCE
  kaldırır; böylece JS varken düzen kayması (CLS) oluşmaz, JS yokken de ölü
  kontrol gösterilmez.
-->
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {
      /*
      Mono yazı tipi de ÖN YÜKLENİR: eyebrow etiketleri, meta rayı ve teknoloji
      adları ilk ekranda görünüyor. Yükleme geciktiğinde takas penceresi
      uzuyor ve fallback ile arasındaki fark düzen kaymasına dönüşüyordu.
    */
    }
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      Object.entries(alternates).map(([altLocale, href]) => (
        <link rel="alternate" hreflang={altLocale} href={new URL(href, canonical).href} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={locale === "tr" ? "tr_TR" : "en_US"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta
      name="twitter:card"
      content={ogImageUrl === undefined ? "summary" : "summary_large_image"}
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "nav.skipToContent")}</a>

    <SiteHeader locale={locale} pathname={Astro.url.pathname} alternates={alternates} />

    <main id="main-content" class:list={[wide && "main--wide"]} tabindex="-1">
      {
        breadcrumbs.length > 1 && (
          <div class="main__breadcrumb">
            <Breadcrumb locale={locale} items={breadcrumbs} />
          </div>
        )
      }
      <slot />
    </main>

    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  /* Tam genişlik: okuma sütunu sınırı kaldırılır, iç boşluk bölümlere devredilir. */
  .main--wide {
    max-width: none;
    padding: 0;
  }

  .main--wide .main__breadcrumb {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md) var(--container-gutter) 0;
  }
</style>

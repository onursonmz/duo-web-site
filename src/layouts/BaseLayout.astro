---
import { buildPageTitle } from "@lib/seo/pageTitle";
import "../styles/base.css";

interface Props {
  /** Sayfaya özgü başlık (yer tutucu; nihai metin S05+). */
  title?: string;
  /** Meta description (yer tutucu). */
  description: string;
}

const { title, description } = Astro.props;

// S00-R2 / ADR-010: kamuya açık iş iddiaları doğrulanmadan yayınlanmaz.
// Buradaki metinler bilinçli olarak nötr yer tutuculardır.
const SITE_NAME = "Duosis";
const pageTitle = buildPageTitle({ pageTitle: title, siteName: SITE_NAME });

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>

    <header class="site-header">
      <p class="site-header__brand">Duosis</p>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Duosis — kurumsal web sitesi yenileme çalışması (geliştirme sürümü).</p>
    </footer>
  </body>
</html>
